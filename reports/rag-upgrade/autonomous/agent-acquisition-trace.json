          "editorial": [
            {
              "id": "editorial:horse-001",
              "text": "赤兔。对应人物:吕布、关羽。朝代/出处:东汉末年《三国志》/《三国演义》。故事:先从吕布,后归关羽,是三国最具辨识度的名马之一。人格标签:忠义、速度、锋芒。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "aa092e3999e59674815539a418a7b43f7719db876c6a2f92f58ea12521faed84",
              "score": 11.355183584563767
            },
            {
              "id": "editorial:horse-076",
              "text": "赤鬃烈马。对应人物:草原英雄/边军。朝代/出处:历史演义混合。故事:野性与爆发兼具,适合疆场硬派角色。人格标签:野性、爆发、自由。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "41e6b58c503066809ea504b1db846ac7d177bc1f7f71478c3f7e80487d4d8a4e",
              "score": 5.7710315197423165
            },
            {
              "id": "editorial:horse-002",
              "text": "乌骓。对应人物:项羽。朝代/出处:秦末汉初《史记·项羽本纪》。故事:垓下兵败后伴随项羽至乌江,成为英雄末路的象征。人格标签:孤勇、逆境、悲壮。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "0b64c2cd0e840cdd294be5b1adb41d59b2fe5274b2fb6ae420094d6d67e157e5",
              "score": 4.461693410965634
            },
            {
              "id": "editorial:horse-062",
              "text": "赤焰流云驹。对应人物:热血先锋。朝代/出处:演义命名传统。故事:像火焰穿云而行的进攻型名驹。人格标签:热烈、速度、先锋。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "325ebe484e9fe8a13591545264aca15c0aa34c0cbc85fecc9a5dc01d4ef501f6",
              "score": 3.9771070967855784
            },
            {
              "id": "editorial:horse-045",
              "text": "绿耳。对应人物:古代名驹。朝代/出处:古籍名马系统。故事:带有独特外貌与神异感。人格标签:灵敏、异相、稀有。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "fd4d4b79489e5927dfe33a10238eb6f5513768a0e0c2c3ff8d578613e8b1b5ab",
              "score": 3.919704591538005
            },
            {
              "id": "editorial:horse-042",
              "text": "赤骥。对应人物:帝王/英雄谱系。朝代/出处:古代名马传统。故事:“赤”与“骥”叠加,天生就有热血传奇感。人格标签:热烈、王气、进取。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "a77b3654d37ee1fdb84782fa6dfaa5dbf95c481f55b3d64e0891758e0860636f",
              "score": 3.766974254347109
            },
            {
              "id": "editorial:horse-039",
              "text": "盗骊。对应人物:先秦名驹谱系。朝代/出处:先秦古籍传统。故事:黑色名骥意象,常作极品良马代称。人格标签:深沉、稀贵、强韧。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "eda00b6be70f8c3e7621fdf0d582026f44e97dff09936773a1f37e1d848e51df",
              "score": 3.6836237781620884
            },
            {
              "id": "editorial:horse-026",
              "text": "紫骍。对应人物:帝王/贵族系统。朝代/出处:史传与诗赋名马意象。故事:紫色骏马常作高贵祥瑞象征。人格标签:华贵、威仪、祥瑞。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "35b6fb87c7bda83d6ae243b737ad35e2d281306abdcb45dd139992f7915090f9",
              "score": 3.3135917856518327
            },
            {
              "id": "editorial:horse-087",
              "text": "赤焰驹。对应人物:少年英雄。朝代/出处:民间叙事。故事:适合成长型热血主角坐骑。人格标签:热血、成长、勇往。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "93157d7e718d064ca690fa80bde342ce2e0f7f85baa3af843da8a36d64c3e248",
              "score": 2.7601562750505604
            },
            {
              "id": "editorial:horse-021",
              "text": "什伐赤。对应人物:李世民。朝代/出处:唐代昭陵六骏。故事:异域命名感强,天然带传奇稀有属性。人格标签:稀有、神秘、贵重。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "851b030d5e427e96722f9a689fed6027f9f3a5370512363628a5343cd72e6a40",
              "score": 2.6226340336565355
            },
            {
              "id": "editorial:horse-069",
              "text": "赤炭火龙驹。对应人物:岳云/高宠型少年猛将。朝代/出处:评书传统。故事:热血、短兵猛冲、少年豪气。人格标签:爆裂、成长、冲锋。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "9496f69ad417924aac0de811c2f081bc792ee8ab7cdf42fafbf1021910af8c6e",
              "score": 2.6226340336565355
            },
            {
              "id": "editorial:horse-085",
              "text": "奔雷驹。对应人物:猛将。朝代/出处:演义命名传统。故事:雷霆式冲锋的典型代表。人格标签:猛进、压制、冲阵。",
              "knowledge_class": "EDITORIAL",
              "review_state": "UNVERIFIED",
              "usable_as_fact": false,
              "revision": "12b65dd1790441035859a0eb7aaef42e9017db1b83befe20edcf1b881d26cf49",
              "score": 1.5285381962858817
            }
