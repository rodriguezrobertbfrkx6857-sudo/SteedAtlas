# 瑙嗛宸ュ巶鐪熷疄 API 鎺ュ叆妯℃澘
# 鍙斁鏈嶅姟鍣ㄧ .env锛屼笉瑕佸啓杩涘墠绔?app.js / HTML銆?
# auto: 鏈夐厤缃氨璋冪敤鐪熷疄 API锛屾病閰嶇疆灏辫蛋鍗犱綅鍥為€€
# placeholder: 姘歌繙涓嶈皟鐢ㄥ閮?API锛屽彧璺戝崰浣嶆祦绋?VIDEO_FACTORY_API_MODE=auto
VIDEO_FACTORY_MEDIA_BASE_URL=/generated
VIDEO_FACTORY_DOWNLOAD_REMOTE_MEDIA=false

# GPT 涓浆绔欙紝鐢ㄤ簬鐢熸垚缁撴瀯鍖栬剼鏈€佸垎闀滃拰 Veo prompt
# 濡傛灉涓嶅～ VIDEO_FACTORY_GPT_*锛屼細鍥為€€浣跨敤 OPENAI_* 閰嶇疆銆?VIDEO_FACTORY_GPT_BASE_URL=
VIDEO_FACTORY_GPT_API_KEY=
VIDEO_FACTORY_GPT_MODEL=
VIDEO_FACTORY_GPT_API_PATH=/chat/completions
VIDEO_FACTORY_GPT_API_STYLE=chat_completions
VIDEO_FACTORY_GPT_MAX_TOKENS=1800
VIDEO_FACTORY_GPT_TIMEOUT_SECONDS=60

# gpt-image-2 涓浆绔欙紝鐢ㄤ簬鐢熸垚鍏抽敭甯у弬鑰冨浘
VIDEO_FACTORY_IMAGE_BASE_URL=
VIDEO_FACTORY_IMAGE_API_KEY=
VIDEO_FACTORY_IMAGE_MODEL=gpt-image-2
VIDEO_FACTORY_IMAGE_API_PATH=/images/generations
VIDEO_FACTORY_IMAGE_SIZE=1024x1792
VIDEO_FACTORY_IMAGE_TIMEOUT_SECONDS=120

# Veo 涓浆绔欙紝鐢ㄤ簬鐢熸垚瑙嗛鐗囨
VIDEO_FACTORY_VEO_BASE_URL=
VIDEO_FACTORY_VEO_API_KEY=
# OpenAI-compatible video generation endpoint, for example:
#   VIDEO_FACTORY_VEO_BASE_URL=https://your-relay.example.com
#   VIDEO_FACTORY_VEO_API_PATH=/v1/videos
# The backend will POST JSON: model, prompt, size, duration, response_format, n.
VIDEO_FACTORY_VEO_MODEL=your-video-model
VIDEO_FACTORY_VEO_API_PATH=/v1/videos
VIDEO_FACTORY_VEO_STATUS_API_PATH=/v1/videos/{task_id}
VIDEO_FACTORY_VEO_REQUEST_FORMAT=openai
VIDEO_FACTORY_VEO_TIMEOUT_SECONDS=180
VIDEO_FACTORY_VEO_GENERATE_AUDIO=true
VIDEO_FACTORY_VEO_ENHANCE_PROMPT=true

