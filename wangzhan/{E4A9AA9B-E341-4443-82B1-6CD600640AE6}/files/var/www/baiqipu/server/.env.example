SECRET_KEY=replace-with-a-random-local-secret
DEBUG=true
CORS_ORIGINS=["http://127.0.0.1:8080","http://localhost:8080"]
APP_PUBLIC_BASE_URL=http://127.0.0.1:8000
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
