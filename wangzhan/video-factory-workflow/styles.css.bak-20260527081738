  background: #090d12;
  color: #dce6f3;
  padding: 12px;
  font-size: 12px;
  line-height: 1.55;
}

.output-empty {
  color: var(--muted);
}

.output-json {
  margin: 0;
  white-space: pre-wrap;
  word-break: break-word;
  font-family:
    "Cascadia Code",
    "Consolas",
    monospace;
}

.output-image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 10px;
}

.output-image-card {
  margin: 0;
  border: 1px solid rgba(141, 163, 193, 0.34);
  border-radius: 8px;
  background: #0d141d;
  overflow: hidden;
}

.output-image-link {
  display: block;
  aspect-ratio: 9 / 16;
  background: #05080d;
}

.output-image-card img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.output-image-card figcaption {
  display: grid;
  gap: 2px;
  padding: 8px;
}

.output-image-card figcaption strong {
  font-size: 12px;
}

.output-image-card figcaption span {
  color: var(--muted);
  font-size: 11px;
}

.output-image-card figcaption p {
  margin: 4px 0 0;
  color: #a9b8cb;
  font-size: 11px;
  line-height: 1.45;
  max-height: 3.1em;
  overflow: hidden;
}

button.task-download-link {
  padding: 0 10px;
}

.json-dialog {
  width: min(860px, calc(100vw - 48px));
  border: 1px solid var(--line);
  border-radius: 14px;
  background: var(--panel);
  color: var(--text);
  padding: 0;
}

.json-dialog::backdrop {
  background: rgba(0, 0, 0, 0.62);
}

.dialog-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid var(--line);
  padding: 12px 14px;
}

#jsonExport {
  width: 100%;
  height: 520px;
  border: 0;
  background: #080c11;
  color: #dce6f3;
  outline: none;
  padding: 14px;
  resize: none;
  font-family:
    "Cascadia Code",
    "Consolas",
    monospace;
  font-size: 12px;
  line-height: 1.55;
}

@media (max-width: 1320px) {
  .app-shell {
    grid-template-columns: 232px minmax(680px, 1fr) 324px;
  }

  .left-rail {
    padding: 16px;
  }

  .inspector {
    padding: 16px;
  }

  .node-brief-panel {
    min-height: 460px;
  }

  .node-brief-grid {
    max-height: 400px;
  }
}

@media (max-height: 900px) {
  .canvas-panel {
    min-height: 400px;
  }
}
