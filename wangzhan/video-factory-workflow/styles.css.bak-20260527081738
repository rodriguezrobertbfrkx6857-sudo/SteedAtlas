:root {
  color-scheme: dark;
  --bg: #0b0d10;
  --panel: #12161d;
  --panel-2: #171d26;
  --panel-3: #0f1319;
  --line: #27313e;
  --line-strong: #3c4b5d;
  --text: #f4f7fb;
  --muted: #98a4b5;
  --soft: #c8d1dc;
  --amber: #efb95a;
  --blue: #65a7ff;
  --cyan: #4ed5d0;
  --green: #58d68d;
  --red: #ff6b7b;
  --violet: #a98bff;
  --pink: #ff8fc7;
  --node-width: 205px;
  --node-height: 150px;
  --shadow: 0 24px 80px rgba(0, 0, 0, 0.38);
}

* {
  box-sizing: border-box;
}

html,
body {
  min-height: 100%;
  height: 100%;
}

body {
  margin: 0;
  overflow: auto;
  background:
    linear-gradient(180deg, rgba(20, 27, 35, 0.92), rgba(8, 10, 12, 1)),
    var(--bg);
  color: var(--text);
  font-family:
    "Microsoft YaHei",
    "PingFang SC",
    "Inter",
    system-ui,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;
  letter-spacing: 0;
}

button,
input,
textarea,
select {
  font: inherit;
}

button {
  cursor: pointer;
}

.app-shell {
  display: grid;
  grid-template-columns: 240px minmax(780px, 1fr) 380px;
  min-height: 100vh;
  min-width: 1120px;
}

.left-rail,
.inspector,
.main-workspace {
  min-height: 0;
}

.left-rail {
  display: flex;
  flex-direction: column;
  gap: 12px;
  overflow-y: auto;
  border-right: 1px solid var(--line);
  background: rgba(12, 15, 20, 0.96);
  padding: 16px;
}

.login-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 100%;
  min-height: 42px;
  border: 1px solid rgba(239, 185, 90, 0.64);
  border-radius: 10px;
  background: #efb95a;
  color: #101620;
  font-weight: 800;
  text-decoration: none;
  box-shadow: 0 12px 30px rgba(239, 185, 90, 0.16);
  transition:
    transform 150ms ease,
    border-color 150ms ease,
    background 150ms ease;
}

.login-link:hover {
  transform: translateY(-1px);
  border-color: rgba(255, 225, 163, 0.82);
  background: #ffd17c;
}

.login-link.logged-in {
  border-color: rgba(88, 214, 141, 0.58);
  background: #173523;
  color: #d9ffe7;
  box-shadow: 0 12px 30px rgba(88, 214, 141, 0.12);
  cursor: default;
}

.login-link.logged-in:hover {
  transform: none;
  border-color: rgba(88, 214, 141, 0.58);
  background: #173523;
}

.back-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 38px;
  align-self: flex-start;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #101620;
  color: var(--soft);
  padding: 0 14px;
  text-decoration: none;
  transition:
    transform 150ms ease,
    border-color 150ms ease,
    color 150ms ease;
}

.back-link:hover {
  transform: translateY(-1px);
  border-color: rgba(101, 167, 255, 0.48);
  color: var(--text);
}

.brand-block {
  display: flex;
  align-items: center;
  gap: 12px;
  min-height: 54px;
}

.brand-mark {
  display: grid;
  width: 44px;
  height: 44px;
  place-items: center;
  border: 1px solid rgba(239, 185, 90, 0.34);
  border-radius: 10px;
  background: linear-gradient(145deg, #2b2114, #12161d);
  color: #ffe1a3;
  font-weight: 800;
}

.brand-name {
  font-size: 17px;
  font-weight: 700;
}

.brand-subtitle,
.page-kicker,
.section-heading,
.rail-label,
.node-type,
.field-help,
.metric span,
.toolbar-meta,
.run-time {
  color: var(--muted);
  font-size: 12px;
}

.rail-section {
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(18, 22, 29, 0.8);
  padding: 12px;
}

.section-heading {
  margin-bottom: 10px;
  font-weight: 700;
}

.node-list {
  display: grid;
  gap: 6px;
}

.node-list-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  width: 100%;
  min-height: 38px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0f141b;
  color: var(--soft);
  padding: 7px 9px;
  text-align: left;
  transition:
    border-color 160ms ease,
    background 160ms ease,
    color 160ms ease;
}

.node-list-item:hover,
.node-list-item.active {
  border-color: rgba(101, 167, 255, 0.55);
  background: #142032;
  color: var(--text);
}

.node-list-name {
  display: flex;
  align-items: center;
  gap: 9px;
  min-width: 0;
}

.node-dot,
.status-dot {
  width: 10px;
  height: 10px;
  flex: 0 0 auto;
  border-radius: 999px;
  background: var(--muted);
  box-shadow: 0 0 0 4px rgba(152, 164, 181, 0.12);
}

.node-dot.input,
.workflow-node.input .status-dot {
  background: var(--cyan);
}

.node-dot.ai,
.workflow-node.ai .status-dot {
  background: var(--violet);
}

.node-dot.image,
.workflow-node.image .status-dot {
  background: var(--pink);
}

.node-dot.video,
.workflow-node.video .status-dot {
  background: var(--blue);
}

.node-dot.audio,
.workflow-node.audio .status-dot {
  background: var(--green);
}

.node-dot.text,
.workflow-node.text .status-dot {
  background: var(--amber);
}

.node-dot.output,
.workflow-node.output .status-dot {
  background: var(--red);
}

.rail-label {
  display: block;
  margin-bottom: 6px;
}

.rail-input,
.field-input,
.field-select,
.field-textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #090d12;
  color: var(--text);
  outline: none;
  padding: 10px 11px;
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
}

.rail-input:focus,
.field-input:focus,
.field-select:focus,
.field-textarea:focus,
.node-quick-input:focus {
  border-color: rgba(101, 167, 255, 0.72);
  box-shadow: 0 0 0 3px rgba(101, 167, 255, 0.16);
}

.engine-card {
  display: grid;
  gap: 6px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0f141b;
  padding: 11px;
}

.engine-card strong {
  font-size: 14px;
}

.engine-card span {
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

.field-textarea {
  min-height: 92px;
  resize: vertical;
}

.rail-note {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin-top: 10px;
}

.status-pill {
  display: inline-flex;
  align-items: center;
  min-height: 24px;
  border: 1px solid var(--line);
  border-radius: 999px;
  padding: 3px 9px;
  color: var(--soft);
  font-size: 12px;
  white-space: nowrap;
}

.status-pill.muted {
  border-color: rgba(78, 213, 208, 0.26);
  background: rgba(78, 213, 208, 0.08);
  color: #bff5f2;
}

.status-pill.waiting {
  border-color: rgba(239, 185, 90, 0.28);
  background: rgba(239, 185, 90, 0.1);
  color: #ffe1a3;
}

.status-pill.queued {
  border-color: rgba(239, 185, 90, 0.28);
  background: rgba(239, 185, 90, 0.1);
  color: #ffe1a3;
}

.status-pill.done {
  border-color: rgba(88, 214, 141, 0.28);
  background: rgba(88, 214, 141, 0.1);
  color: #bdf1d2;
}

.status-pill.running {
  border-color: rgba(101, 167, 255, 0.34);
  background: rgba(101, 167, 255, 0.12);
  color: #cfe3ff;
}

.rail-button,
.primary-button,
.ghost-button,
.icon-button {
  border: 1px solid transparent;
  border-radius: 10px;
  min-height: 38px;
  color: var(--text);
  transition:
    transform 150ms ease,
    border-color 150ms ease,
    background 150ms ease;
}

.rail-button {
  display: block;
  width: 100%;
  margin-top: 8px;
  background: #233247;
}

.rail-button.compact {
  min-height: 34px;
  margin-top: 0;
  padding: 0 10px;
}

.rail-button.secondary,
.ghost-button {
  border-color: var(--line);
  background: #101620;
}

.primary-button {
  min-width: 124px;
  background: linear-gradient(135deg, #f2c16d, #5db8ff);
  color: #091019;
  font-weight: 800;
}

.icon-button {
  width: 38px;
  background: #101620;
  border-color: var(--line);
  color: var(--soft);
  font-weight: 800;
}

.ghost-button {
  padding: 0 14px;
}

.ghost-button.compact {
  min-height: 32px;
}

.run-panel-actions {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8px;
  flex-wrap: wrap;
}

.download-button {
  min-height: 32px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #141a22;
  color: var(--muted);
  padding: 0 14px;
  font-weight: 800;
  cursor: not-allowed;
  transition:
    transform 150ms ease,
    border-color 150ms ease,
    background 150ms ease,
    color 150ms ease;
}

.download-button.ready {
  border-color: rgba(88, 214, 141, 0.48);
  background: rgba(88, 214, 141, 0.15);
  color: #d9ffe7;
  cursor: pointer;
}

.download-button.ready:hover {
  transform: translateY(-1px);
  border-color: rgba(88, 214, 141, 0.72);
  background: rgba(88, 214, 141, 0.22);
}

.rail-button:hover,
.primary-button:hover,
.ghost-button:hover,
.icon-button:hover {
  transform: translateY(-1px);
  border-color: rgba(101, 167, 255, 0.48);
}

.main-workspace {
  display: flex;
  flex-direction: column;
  gap: 10px;
  overflow-x: hidden;
  overflow-y: auto;
  padding: 16px;
}

.topbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
}

.topbar h1 {
  margin: 4px 0 0;
  font-size: 24px;
  line-height: 1.2;
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.status-strip {
  display: grid;
  grid-template-columns: 104px 104px 136px 1fr;
  gap: 8px;
}

.metric {
  min-height: 50px;
  border: 1px solid var(--line);
  border-radius: 12px;
  background: rgba(18, 22, 29, 0.82);
  padding: 8px 10px;
}

.metric strong {
  display: block;
  margin-top: 5px;
  overflow: hidden;
  color: var(--text);
  font-size: 18px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.metric.wide strong {
  font-size: 15px;
}

.canvas-panel {
  display: flex;
  min-height: 0;
  flex: 0 0 auto;
  flex-direction: column;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(13, 16, 22, 0.92);
  box-shadow: var(--shadow);
  min-height: 0;
}

.canvas-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 42px;
  border-bottom: 1px solid var(--line);
  padding: 0 14px;
}

.toolbar-title {
  font-weight: 700;
}

.toolbar-meta {
  align-items: center;
  display: flex;
  gap: 10px;
  flex-wrap: wrap;
  justify-content: flex-end;
}

.runtime-badge {
  border: 1px solid rgba(239, 185, 90, 0.32);
  border-radius: 999px;
  background: rgba(239, 185, 90, 0.1);
  color: #ffe1a3;
  font-size: 11px;
  font-weight: 800;
  line-height: 1;
  padding: 6px 9px;
}

.runtime-badge.connected {
  border-color: rgba(88, 214, 141, 0.36);
  background: rgba(88, 214, 141, 0.12);
  color: #bdf1d2;
}

.runtime-badge.offline {
  border-color: rgba(255, 107, 123, 0.34);
  background: rgba(255, 107, 123, 0.1);
  color: #ffb8c1;
}

.history-actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin-bottom: 10px;
}

.history-actions .danger {
  grid-column: 1 / -1;
}

.task-list {
  display: grid;
  gap: 8px;
  max-height: 320px;
  overflow-y: auto;
  padding-right: 4px;
  scrollbar-width: thin;
  scrollbar-color: rgba(101, 167, 255, 0.42) rgba(8, 12, 18, 0.6);
}

.task-list-empty {
  border: 1px dashed var(--line);
  border-radius: 10px;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
  padding: 10px;
}

.task-card {
  position: relative;
  display: grid;
  gap: 8px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0f141b;
  color: var(--soft);
  padding: 10px;
  text-align: left;
  transition:
    border-color 160ms ease,
    background 160ms ease,
  color 160ms ease;
}

.task-delete-button {
  position: absolute;
  top: 7px;
  right: 7px;
  min-height: 24px;
  border: 1px solid rgba(255, 107, 123, 0.28);
  border-radius: 7px;
  background: rgba(255, 107, 123, 0.09);
  color: #ffb8c1;
  padding: 0 7px;
  font-size: 11px;
  font-weight: 800;
  opacity: 0.78;
}

.task-delete-button:hover {
  border-color: rgba(255, 107, 123, 0.58);
  background: rgba(255, 107, 123, 0.16);
  opacity: 1;
}

.task-card-main {
  display: grid;
  gap: 8px;
  width: 100%;
  border: 0;
  background: transparent;
  color: inherit;
  padding: 0 38px 0 0;
  text-align: left;
}

.task-card.active {
  border-color: rgba(101, 167, 255, 0.55);
  background: #142032;
  color: var(--text);
}

.task-card-title {
  color: var(--text);
  font-size: 13px;
  font-weight: 700;
  line-height: 1.4;
}

.task-card-meta {
  color: var(--muted);
  font-size: 11px;
}

.task-card-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
}

.task-card-progress {
  height: 5px;
  overflow: hidden;
  border-radius: 999px;
  background: #0a0f15;
}

.task-card-progress span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--blue), var(--green));
}

.task-download-link {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 30px;
  border: 1px solid rgba(88, 214, 141, 0.32);
  border-radius: 8px;
  background: rgba(88, 214, 141, 0.1);
  color: #bdf1d2;
  font-size: 12px;
  font-weight: 700;
  text-decoration: none;
}

.task-download-link:hover {
  border-color: rgba(88, 214, 141, 0.58);
  background: rgba(88, 214, 141, 0.16);
}

.canvas-viewport {
  position: relative;
  height: 560px;
  overflow: hidden;
  cursor: grab;
  background:
    radial-gradient(circle at top left, rgba(101, 167, 255, 0.1), transparent 22%),
    linear-gradient(180deg, #0b0f15, #0a0d12);
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.035) 1px, transparent 1px),
    linear-gradient(90deg, rgba(255, 255, 255, 0.035) 1px, transparent 1px);
  background-size: 28px 28px;
}

.canvas-viewport.panning {
  cursor: grabbing;
}

.canvas-inner {
  position: relative;
  width: 1680px;
  height: 860px;
  transform-origin: 0 0;
}

.link-layer,
.nodes-layer {
  position: absolute;
  inset: 0;
}

.link-path {
  fill: none;
  stroke: rgba(132, 152, 176, 0.82);
  stroke-width: 2.7;
  stroke-linecap: round;
  filter: drop-shadow(0 0 5px rgba(101, 167, 255, 0.14));
  pointer-events: none;
  transition:
    stroke 180ms ease,
    opacity 180ms ease,
    stroke-width 180ms ease;
}

.link-path.done,
.link-path.phase-done {
  stroke: rgba(88, 214, 141, 0.92);
  stroke-width: 3;
}

.link-path.phase-primed {
  stroke: rgba(239, 185, 90, 0.72);
  stroke-dasharray: 3 10;
}

.link-path.flowing,
.link-path.phase-flowing {
  stroke: rgba(101, 167, 255, 1);
  stroke-width: 3.4;
  stroke-dasharray: 9 12;
  animation: dashFlow 720ms linear infinite;
}

.link-path.phase-failed {
  stroke: rgba(255, 107, 123, 0.96);
}

.link-path.link-emphasis {
  stroke-width: 3.2;
  stroke: rgba(147, 190, 255, 0.98);
  filter: drop-shadow(0 0 7px rgba(101, 167, 255, 0.28));
}

.link-packet {
  fill: #d6efff;
  filter: drop-shadow(0 0 8px rgba(101, 167, 255, 0.92));
  pointer-events: none;
}

@keyframes dashFlow {
  to {
    stroke-dashoffset: -42;
  }
}

.workflow-node {
  position: absolute;
  width: var(--node-width);
  min-height: var(--node-height);
  overflow: hidden;
  border: 1px solid var(--line-strong);
  border-radius: 14px;
  background: rgba(18, 23, 31, 0.96);
  box-shadow: 0 16px 46px rgba(0, 0, 0, 0.28);
  transition:
    border-color 160ms ease,
    box-shadow 160ms ease;
  will-change: transform;
}

.workflow-node::before {
  position: absolute;
  inset: -1px;
  border-radius: inherit;
  background:
    linear-gradient(135deg, rgba(101, 167, 255, 0.28), transparent 34%),
    linear-gradient(315deg, rgba(88, 214, 141, 0.2), transparent 38%);
  content: "";
  opacity: 0;
  pointer-events: none;
  transition: opacity 180ms ease;
}

.workflow-node.phase-running,
.workflow-node.phase-current {
  border-color: rgba(101, 167, 255, 0.94);
  box-shadow:
    0 0 0 3px rgba(101, 167, 255, 0.12),
    0 0 32px rgba(101, 167, 255, 0.24),
    0 20px 56px rgba(0, 0, 0, 0.44);
}

.workflow-node.phase-current {
  animation: nodeCurrentPulse 1.8s ease-in-out infinite;
}

.workflow-node.parallel-active::after {
  position: absolute;
  top: 8px;
  right: 8px;
  border: 1px solid rgba(125, 211, 252, 0.38);
  border-radius: 999px;
  background: rgba(14, 165, 233, 0.16);
  color: #c7efff;
  content: "并行";
  font-size: 11px;
  font-weight: 900;
  line-height: 1;
  padding: 4px 7px;
  pointer-events: none;
}

.workflow-node.phase-current::before,
.workflow-node.phase-running::before {
  opacity: 1;
}

.workflow-node.phase-done {
  box-shadow:
    0 0 0 2px rgba(88, 214, 141, 0.1),
    0 14px 42px rgba(0, 0, 0, 0.3);
}

.workflow-node.phase-done .node-burst {
  animation: nodeDoneBurst 700ms ease-out 1;
}

.workflow-node.phase-failed {
  border-color: rgba(255, 107, 123, 0.78);
  box-shadow:
    0 0 0 3px rgba(255, 107, 123, 0.1),
    0 18px 52px rgba(0, 0, 0, 0.38);
}

.node-scan,
.node-burst {
  position: absolute;
  inset: 0;
  border-radius: inherit;
  pointer-events: none;
}

.node-scan {
  background: linear-gradient(100deg, transparent 0%, rgba(255, 255, 255, 0.16) 46%, transparent 72%);
  opacity: 0;
  transform: translateX(-115%);
}

.workflow-node.phase-current .node-scan,
.workflow-node.phase-running .node-scan {
  animation: nodeScan 1.9s ease-in-out infinite;
  opacity: 1;
}

.node-burst {
  border: 1px solid rgba(88, 214, 141, 0.8);
  opacity: 0;
}

.workflow-node.dragging {
  z-index: 5;
  box-shadow:
    0 0 0 3px rgba(101, 167, 255, 0.12),
    0 24px 70px rgba(0, 0, 0, 0.48);
}

.workflow-node.selected {
  border-color: rgba(101, 167, 255, 0.78);
  box-shadow:
    0 0 0 3px rgba(101, 167, 255, 0.15),
    0 20px 56px rgba(0, 0, 0, 0.42);
}

.workflow-node.running {
  border-color: rgba(101, 167, 255, 0.9);
}

.workflow-node.queued {
  border-color: rgba(239, 185, 90, 0.7);
}

.workflow-node.done {
  border-color: rgba(88, 214, 141, 0.72);
}

.node-top {
  display: flex;
  align-items: center;
  gap: 9px;
  min-height: 46px;
  border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  padding: 8px 10px;
  cursor: grab;
  touch-action: none;
  user-select: none;
}

.node-top:active {
  cursor: grabbing;
}

.node-title-block {
  min-width: 0;
  flex: 1;
}

.node-title {
  overflow: hidden;
  font-size: 14px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-type {
  margin-top: 1px;
}

.node-index {
  display: grid;
  width: 28px;
  height: 28px;
  flex: 0 0 auto;
  place-items: center;
  border: 1px solid var(--line);
  border-radius: 8px;
  background: #0c1118;
  color: var(--soft);
  font-size: 11px;
  font-weight: 800;
}

.node-body {
  padding: 9px 10px;
}

.node-quick-input {
  width: 100%;
  min-height: 48px;
  max-height: 62px;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0a0f15;
  color: var(--text);
