  font-size: 12px;
}

.node-value span:first-child {
  color: var(--muted);
}

.node-value strong {
  overflow: hidden;
  color: var(--text);
  font-weight: 600;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 8px;
  padding: 0 10px 10px;
}

.node-progress {
  position: relative;
  height: 7px;
  flex: 1;
  overflow: hidden;
  border-radius: 999px;
  background: #0a0f15;
}

.node-progress span {
  position: absolute;
  inset: 0 auto 0 0;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--blue), var(--green));
  box-shadow: 0 0 12px rgba(101, 167, 255, 0.48);
  transition: width 260ms ease;
}

.workflow-node.phase-current .node-progress span,
.workflow-node.phase-running .node-progress span {
  background-size: 180% 100%;
  animation: progressGlow 900ms linear infinite;
}

.node-status-text {
  width: 40px;
  color: var(--muted);
  font-size: 11px;
  text-align: right;
}

.port {
  position: absolute;
  width: 10px;
  height: 10px;
  border: 2px solid #0b0f15;
  border-radius: 999px;
  background: var(--blue);
  top: 62px;
}

.port.in {
  left: -7px;
}

.port.out {
  right: -7px;
}

.run-panel {
  min-height: 220px;
  max-height: 260px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(18, 22, 29, 0.84);
  padding: 10px;
}

.node-brief-panel {
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(13, 16, 22, 0.92);
  padding: 12px;
  min-height: 460px;
}

.node-brief-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 12px;
  max-height: 430px;
  margin-top: 10px;
  overflow-y: auto;
  padding-right: 6px;
  align-content: start;
  border-radius: 12px;
  background: rgba(13, 16, 22, 0.92);
}

.node-brief-empty {
  border: 1px dashed var(--line);
  border-radius: 10px;
  color: var(--muted);
  font-size: 13px;
  line-height: 1.6;
  padding: 14px;
}

.node-brief-card {
  display: grid;
  gap: 8px;
  border: 1px solid rgba(60, 75, 93, 0.86);
  border-radius: 10px;
  background:
    linear-gradient(180deg, rgba(20, 28, 39, 0.96), rgba(14, 20, 28, 0.96));
  padding: 12px;
  min-height: 286px;
  max-height: 360px;
  grid-template-rows: auto auto auto minmax(0, 1fr);
  overflow: hidden;
}

.node-brief-card.done {
  border-color: rgba(88, 214, 141, 0.44);
}

.node-brief-card.running {
  border-color: rgba(101, 167, 255, 0.56);
}

.node-brief-card.failed {
  border-color: rgba(255, 107, 123, 0.62);
}

.node-brief-card.attention {
  border-color: rgba(239, 185, 90, 0.72);
  box-shadow: 0 0 0 1px rgba(239, 185, 90, 0.18);
}

.node-brief-head {
  display: flex;
  align-items: center;
  gap: 10px;
}

.node-brief-index {
  display: grid;
  width: 24px;
  height: 24px;
  place-items: center;
  border-radius: 8px;
  background: #182434;
  color: var(--text);
  font-size: 11px;
  font-weight: 800;
}

.node-brief-title-wrap {
  min-width: 0;
}

.node-brief-title-wrap strong,
.node-brief-title-wrap small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.node-brief-title-wrap strong {
  color: var(--text);
  font-size: 13px;
}

.node-brief-title-wrap small {
  color: var(--muted);
  font-size: 11px;
}

.node-brief-title {
