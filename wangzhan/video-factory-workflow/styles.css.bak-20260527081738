  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.brief-chip-row {
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.node-brief-body {
  display: grid;
  gap: 8px;
  align-content: start;
  min-height: 0;
  overflow: auto;
  padding-right: 2px;
}

.brief-chip {
  border: 1px solid rgba(141, 163, 193, 0.36);
  border-radius: 6px;
  background: rgba(141, 163, 193, 0.12);
  color: #d6e2f1;
  font-size: 11px;
  font-weight: 700;
  line-height: 1.2;
  padding: 6px 10px;
  display: inline-flex;
  align-items: center;
  min-height: 26px;
}

.brief-line-list {
  display: grid;
  gap: 6px;
  margin: 0;
  padding: 0;
  list-style: none;
}

.brief-line-list li {
  color: #d4dfed;
  font-size: 13px;
  line-height: 1.45;
  border: 1px solid rgba(141, 163, 193, 0.24);
  border-radius: 6px;
  background: rgba(8, 12, 18, 0.56);
  padding: 6px 8px;
  overflow: hidden;
  overflow-wrap: anywhere;
  word-break: break-word;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
}

.brief-image-grid {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.brief-image-item {
  margin: 0;
}

.brief-image-item a {
  display: block;
  overflow: hidden;
  border: 1px solid rgba(141, 163, 193, 0.3);
  border-radius: 8px;
  background: #0a1016;
  aspect-ratio: 4 / 5;
}

.brief-image-item img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  display: block;
}

.brief-image-item figcaption {
  overflow: hidden;
  color: var(--muted);
  font-size: 11px;
  margin-top: 4px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.xhs-quick-steps {
  margin: 8px 0 0;
  padding-left: 16px;
  color: #d4dfed;
  font-size: 12px;
  line-height: 1.5;
}

.xhs-guide-block {
  border: 1px solid rgba(141, 163, 193, 0.2);
  border-radius: 8px;
  background: rgba(8, 12, 18, 0.46);
  padding: 8px 10px;
  margin-top: 8px;
}

.xhs-guide-title {
  color: #dbe7f6;
  font-size: 12px;
  font-weight: 700;
  margin-bottom: 6px;
}

.xhs-kv-list,
.xhs-error-list {
  margin: 0;
  padding: 0;
  list-style: none;
  display: grid;
  gap: 6px;
}

.xhs-kv-list li,
.xhs-error-list li {
  display: grid;
  gap: 2px;
  color: #d4dfed;
  font-size: 12px;
  line-height: 1.45;
  border: 1px solid rgba(141, 163, 193, 0.15);
  border-radius: 6px;
  background: rgba(12, 18, 25, 0.72);
  padding: 6px 8px;
}

.xhs-kv-list li strong,
.xhs-error-list li strong {
  color: #eff5ff;
  font-size: 12px;
}

.xhs-kv-list code {
  font-family:
    "Cascadia Code",
    "Consolas",
    monospace;
  color: #f1f6ff;
  background: rgba(6, 10, 16, 0.8);
  border: 1px solid rgba(141, 163, 193, 0.25);
  border-radius: 4px;
  padding: 1px 4px;
}

.run-panel-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
}

.run-panel-header strong {
  display: block;
  margin-top: 3px;
}

.execution-pulse {
  display: grid;
  grid-template-columns: minmax(96px, 150px) 1fr 44px;
  align-items: center;
  gap: 10px;
  min-height: 34px;
  margin-top: 12px;
  border: 1px solid rgba(255, 255, 255, 0.07);
  border-radius: 10px;
  background: rgba(8, 13, 19, 0.78);
  padding: 7px 9px;
}

.pulse-label,
.pulse-percent {
  overflow: hidden;
  color: var(--soft);
  font-size: 12px;
  font-weight: 800;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.pulse-percent {
  color: var(--muted);
  text-align: right;
}

.pulse-track {
  position: relative;
  height: 8px;
  overflow: hidden;
  border-radius: 999px;
  background: #07101a;
}

.pulse-fill {
  position: absolute;
  inset: 0 auto 0 0;
  width: 0;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--blue), var(--cyan), var(--green));
  box-shadow: 0 0 18px rgba(78, 213, 208, 0.42);
  transition: width 260ms ease;
}

.pulse-runner {
  position: absolute;
  top: -4px;
  bottom: -4px;
  width: 42px;
  border-radius: 999px;
  background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.65), transparent);
  opacity: 0;
  transform: translateX(-48px);
}

.execution-pulse.active .pulse-runner {
  animation: pulseRunner 1.25s linear infinite;
  opacity: 1;
}

.execution-timeline {
  display: grid;
  grid-template-columns: repeat(9, minmax(92px, 1fr));
  gap: 6px;
  margin-top: 8px;
  overflow-x: auto;
  padding-bottom: 2px;
}

.timeline-step {
  position: relative;
  display: grid;
  min-width: 92px;
  min-height: 50px;
  gap: 5px;
  overflow: hidden;
  border: 1px solid var(--line);
  border-radius: 10px;
  background: #0d131a;
  color: var(--soft);
  padding: 7px;
  text-align: left;
}

.timeline-step.current {
  border-color: rgba(101, 167, 255, 0.74);
  box-shadow: 0 0 0 3px rgba(101, 167, 255, 0.13);
  animation: stepPulse 1.4s ease-in-out infinite;
}

.timeline-step.parallel-active {
  background:
    linear-gradient(135deg, rgba(101, 167, 255, 0.13), rgba(88, 214, 141, 0.08)),
    #0d131a;
}

.timeline-step.phase-current::before,
.timeline-step.phase-running::before {
  position: absolute;
  inset: 0;
  background: linear-gradient(110deg, transparent, rgba(255, 255, 255, 0.09), transparent);
  content: "";
  transform: translateX(-100%);
  animation: stepSweep 1.6s ease-in-out infinite;
}

.timeline-step.done {
  border-color: rgba(88, 214, 141, 0.42);
  background: rgba(88, 214, 141, 0.08);
}

.timeline-step.running {
  border-color: rgba(101, 167, 255, 0.54);
  background: rgba(101, 167, 255, 0.1);
}

.timeline-step.queued {
  border-color: rgba(239, 185, 90, 0.42);
  background: rgba(239, 185, 90, 0.08);
}

.timeline-step.failed {
  border-color: rgba(255, 107, 123, 0.52);
  background: rgba(255, 107, 123, 0.1);
}

.timeline-index {
  display: grid;
  width: 22px;
  height: 22px;
  place-items: center;
  border-radius: 7px;
  background: #111a24;
  color: var(--text);
  font-size: 11px;
  font-weight: 800;
}

.timeline-copy strong,
.timeline-copy small {
  display: block;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.timeline-copy strong {
  color: var(--text);
  font-size: 12px;
}

.timeline-copy small {
  margin-top: 2px;
  color: var(--muted);
  font-size: 11px;
}

.timeline-bar {
  height: 4px;
  overflow: hidden;
  border-radius: 999px;
  background: #081019;
}

.timeline-bar span {
  display: block;
  height: 100%;
  border-radius: inherit;
  background: linear-gradient(90deg, var(--blue), var(--green));
  transition: width 240ms ease;
}

.runtime-events {
  display: grid;
  grid-template-columns: repeat(5, minmax(112px, 1fr));
  gap: 6px;
  margin-top: 7px;
  overflow-x: auto;
}

.runtime-event {
  display: grid;
  gap: 2px;
  min-height: 38px;
  border: 1px solid var(--line);
  border-radius: 9px;
  background: #0b1118;
  padding: 6px 7px;
}

.runtime-event span,
.runtime-event small {
  overflow: hidden;
  color: var(--muted);
  font-size: 10px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runtime-event strong {
  overflow: hidden;
  color: var(--soft);
  font-size: 12px;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.runtime-event.running {
  border-color: rgba(101, 167, 255, 0.48);
  background: rgba(101, 167, 255, 0.09);
}

.runtime-event.done {
  border-color: rgba(88, 214, 141, 0.44);
  background: rgba(88, 214, 141, 0.08);
}

.runtime-event.muted {
  display: block;
  color: var(--muted);
  font-size: 12px;
  line-height: 1.6;
}

@keyframes stepPulse {
  50% {
    box-shadow: 0 0 0 4px rgba(101, 167, 255, 0.2);
  }
}

@keyframes nodeCurrentPulse {
  50% {
    box-shadow:
      0 0 0 4px rgba(101, 167, 255, 0.16),
      0 0 38px rgba(101, 167, 255, 0.3),
      0 20px 56px rgba(0, 0, 0, 0.44);
  }
}

@keyframes nodeScan {
  0% {
    transform: translateX(-115%);
  }
  55%,
  100% {
    transform: translateX(115%);
  }
}

@keyframes nodeDoneBurst {
  0% {
    opacity: 0.8;
    transform: scale(0.94);
  }
  100% {
    opacity: 0;
    transform: scale(1.08);
  }
}

@keyframes progressGlow {
  to {
    background-position: 180% 0;
  }
}

@keyframes pulseRunner {
  to {
    transform: translateX(720px);
  }
}

@keyframes stepSweep {
  55%,
  100% {
    transform: translateX(100%);
  }
}

.run-log {
  display: grid;
  max-height: 50px;
  gap: 6px;
  margin-top: 8px;
  overflow-y: auto;
  padding-right: 4px;
}

.run-log-item {
  display: grid;
  grid-template-columns: 70px 1fr;
  gap: 10px;
  border: 1px solid rgba(255, 255, 255, 0.06);
  border-radius: 10px;
  background: rgba(10, 14, 20, 0.68);
  padding: 6px 8px;
  font-size: 12px;
}

.run-log-item strong {
  color: var(--soft);
}

.inspector {
