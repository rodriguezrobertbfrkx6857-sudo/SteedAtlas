    .map((_, index) => {
      const shot = storyboard.output?.shots?.[index];
      return `<div class="scene-chip ${index < activeCount ? "active" : ""}">镜头 ${index + 1}<br>${escapeHtml(shot?.camera || "待生成")}</div>`;
