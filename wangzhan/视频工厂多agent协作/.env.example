# Codex / OpenAI Responses API
# 真实调用时填写；不填会进入模拟模式，方便先看多 Agent 调度效果。
CODEX_API_KEY=
CODEX_BASE_URL=https://api.openai.com/v1
CODEX_MODEL=gpt-5.3-codex
CODEX_TIMEOUT_MS=90000
CODEX_MOCK_MODE=auto

# 原视频工厂后端，可选。
# 如果只想用本项目做多 Agent 预生产和提效分析，可以先不填。
VIDEO_FACTORY_BASE_URL=http://127.0.0.1:8000/api/v1/video/workflow
VIDEO_FACTORY_ACCESS_TOKEN=

# 调度控制
VIDEO_FACTORY_AGENT_CONCURRENCY=4
VIDEO_FACTORY_CLIP_CONCURRENCY=3
